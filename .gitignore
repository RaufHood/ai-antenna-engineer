# Agent / tooling state (shared team config stays tracked)
.claude/*
!.claude/settings.json
.entire/*
!.entire/.gitignore
!.entire/settings.json

# Environments & secrets.
# Devin service-user keys are prefixed cog_ and org ids org-; they belong in
# backend/.env (see backend/.env.example), never in a tracked file. If one is
# ever committed, rotating it at app.devin.ai is the only real fix — removing
# the commit is not enough once it has been pushed.
.env
.env.*
!.env.example
.envrc
*.pem
*.key
*.p12
*.pfx
secrets.*
*secret*.json
*credentials*.json
service-account*.json

# Python
__pycache__/
*.py[cod]
.venv*/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Vendored binaries (downloaded, not source-controlled — see rf/progress_simulation.md)
rf/vendor/

# Node
node_modules/
.next/
out/
coverage/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs & scratch
*.log
tmp/

# run artifacts: media + json yes (reviewers see results without running),
# raw field dumps no (tens of MB each)
runs/**/Et.h5
rf/vendor/
rf/blend_loader/out/

# orbit frames are build intermediates: the gif/mp4 carry the same content
# and rendering them again is one command (see rf/README.md)
runs/**/orbit_frames/
