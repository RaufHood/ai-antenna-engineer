# Agent / tooling state (shared team config stays tracked)
.claude/*
!.claude/settings.json
.entire/*
!.entire/.gitignore
!.entire/settings.json

# Environments & secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv*/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Vendored binaries (downloaded, not source-controlled — see rf/progress_simulation.md)
rf/vendor/

# Node
node_modules/
.next/
out/
coverage/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs & scratch
*.log
tmp/

# run artifacts: media + json yes (reviewers see results without running),
# raw field dumps no (tens of MB each)
runs/**/Et.h5
rf/vendor/
rf/blend_loader/out/

# orbit frames are build intermediates: the gif/mp4 carry the same content
# and rendering them again is one command (see rf/README.md)
runs/**/orbit_frames/
