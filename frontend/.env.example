# Copy to .env.local (gitignored). Both are read server-side by the Next.js
# route handlers, never shipped to the browser.

# Where the FastAPI backend listens. The UI proxies every run through it;
# when it is unreachable the UI falls back to a local heuristic and says so.
BACKEND_URL=http://127.0.0.1:8000

# Default agent for a run: "mock" (offline heuristic agent on the backend, no
# credentials) or "devin" (needs backend/.env). The panel toggle overrides it.
AGENT=mock
