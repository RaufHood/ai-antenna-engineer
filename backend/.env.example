# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Devin API (https://app.devin.ai -> settings -> API keys).
# Service-user keys are prefixed cog_.
DEVIN_API_KEY=cog_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEVIN_ORG_ID=org-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ACU = Devin's compute unit. Cap it so a runaway loop cannot burn the budget.
DEVIN_MAX_ACU=5

# Agent backend: "devin" for the real thing, "mock" for the offline heuristic
# stand-in (no key needed, same interface).
AGENT=mock

# Solver: leave unset for the fast in-process PyNEC oracle (milliseconds).
# SIM_SOLVER=app.sim.rf_adapter:solve   # openEMS FDTD via rf/cli.py — minutes
